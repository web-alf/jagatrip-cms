# Salin ke .env lalu isi. Dashboard Supabase → Project Settings → API.
# PUBLIC_* ikut ter-bundle ke browser (aman: anon key + RLS).
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Server-only. JANGAN pakai prefix PUBLIC_, jangan commit.
SUPABASE_SERVICE_ROLE_KEY=

# Tabel yang di-ping cron keepalive (harus ada & readable oleh anon).
KEEPALIVE_TABLE=keepalive
