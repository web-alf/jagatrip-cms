---
import Base from "../layouts/Base.astro";
---
<Base title="Halaman Tidak Ditemukan — JAGATRIP" description="Halaman yang Anda cari tidak ditemukan.">
  <section style="position:relative;overflow:hidden;border-bottom:1px solid var(--border)">
    <svg aria-hidden="true" class="deco" viewBox="0 0 1440 400" preserveAspectRatio="none">
      <path d="M-40 340 C 340 306 620 136 1000 92 C 1170 72 1320 54 1500 36" fill="none" stroke="#F97316" stroke-width="2" stroke-dasharray="2 10" opacity=".45" />
      <g transform="translate(1455 22) rotate(-6) scale(.8)" opacity=".45"><path d="M3 13l18-7-7 18-2.6-7.4L3 13z" fill="#F97316" /></g>
    </svg>
    <div class="wrap" style="padding-block:clamp(60px,9vw,120px);text-align:center">
      <p class="eyebrow">ERROR 404</p>
      <h1 class="h1" style="font-size:clamp(34px,5vw,62px)">Halaman Tidak Ditemukan</h1>
      <p class="lead" style="margin-inline:auto">Halaman yang Anda cari mungkin sudah dipindahkan, dihapus, atau alamatnya salah ketik.</p>
      <div class="btns" style="justify-content:center;margin-top:32px">
        <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
        <a href="/program" class="btn">Lihat Program</a>
      </div>
    </div>
  </section>
</Base>
