import "../styles/lp/batch2.css";
import Footer from "../components/site/Footer.astro";
---
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#011F48">
<title>Sekolah &amp; Kampus Anda, Go International | JAGATRIP, 11–14 Januari 2027</title>
<meta name="description" content="Penjajakan kerja sama pendidikan langsung di kampus Malaysia untuk pimpinan sekolah, perguruan tinggi, dan yayasan. 11–14 Januari 2027. Rp14,2 juta per orang all-in, termasuk tiket pesawat.">
<link rel="canonical" href="https://jagatrip.com/batch2">
<meta property="og:type" content="website">
<meta property="og:url" content="https://jagatrip.com/batch2">
<meta property="og:title" content="Sekolah &amp; Kampus Anda, Go International">
<meta property="og:description" content="Penjajakan kerja sama pendidikan langsung di kampus Malaysia, 11–14 Januari 2027.">
<meta property="og:image" content="https://jagatrip.com/images/batch2/flyer-front.webp">
<link rel="icon" type="image/webp" href="/images/batch2/favicon.webp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 4 5.7 4 9s-1.4 6.4-4 9c-2.6-2.6-4-5.7-4-9s1.4-6.4 4-9Z"/></symbol>
<symbol id="i-board" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M12 16v4M8 20h8M7.5 12l3-3 2.5 2 3.5-4"/></symbol>
<symbol id="i-cap" viewBox="0 0 24 24"><path d="M2.5 9.5 12 5l9.5 4.5L12 14Z"/><path d="M6.5 11.5V16c0 1.2 2.6 2.8 5.5 2.8s5.5-1.6 5.5-2.8v-4.5M21.5 9.5V15"/></symbol>
<symbol id="i-plane" viewBox="0 0 24 24"><path d="M21 3 3 10.5l6.8 2.7L12.5 20 21 3Zm0 0L9.8 13.2"/></symbol>
<symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M15.5 5.2a3.2 3.2 0 0 1 0 5.6M17.5 14.9c2 .7 3.5 2.6 3.5 5.1"/></symbol>
<symbol id="i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5Z"/></symbol>
<symbol id="i-route" viewBox="0 0 24 24"><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="5" r="2.2"/><path d="M8.2 19H15a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h6.8"/></symbol>
<symbol id="i-home" viewBox="0 0 24 24"><path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M12 17.2s-3-1.8-3-3.7a1.6 1.6 0 0 1 3-.8 1.6 1.6 0 0 1 3 .8c0 1.9-3 3.7-3 3.7Z"/></symbol>
<symbol id="i-bank" viewBox="0 0 24 24"><path d="M3 9.5 12 4l9 5.5H3Z"/><path d="M6 9.5V17M10 9.5V17M14 9.5V17M18 9.5V17M3.5 20.5h17M4.5 17h15"/></symbol>
<symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 4.5h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-4 3.5v-3.5H4a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Z"/><path d="M20 9h.5A1.5 1.5 0 0 1 22 10.5v5a1.5 1.5 0 0 1-1.5 1.5H20v3l-3.5-3H13"/></symbol>
<symbol id="i-award" viewBox="0 0 24 24"><circle cx="12" cy="9" r="5.5"/><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"/></symbol>
<symbol id="i-swap" viewBox="0 0 24 24"><path d="M4 8h14M14.5 4.5 18 8l-3.5 3.5M20 16H6M9.5 12.5 6 16l3.5 3.5"/></symbol>
<symbol id="i-map" viewBox="0 0 24 24"><path d="m9 4-6 2.2v13.6L9 17.6l6 2.4 6-2.2V4.2L15 6.4 9 4Z"/><path d="M9 4v13.6M15 6.4V20"/></symbol>
<symbol id="i-case" viewBox="0 0 24 24"><rect x="3" y="7.5" width="18" height="12" rx="2"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5M3 13h18M12 12v2"/></symbol>
<symbol id="i-flask" viewBox="0 0 24 24"><path d="M9 3.5h6M10.5 3.5v6L4.8 18a1.8 1.8 0 0 0 1.5 2.8h11.4a1.8 1.8 0 0 0 1.5-2.8L13.5 9.5v-6M7.5 15h9"/></symbol>
<symbol id="i-badge" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.7 2.7 5.3-5.6"/></symbol>
<symbol id="i-link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3.2-3.2a4 4 0 0 0-5.7-5.7L12 6.3"/><path d="M14 10a4 4 0 0 0-5.7 0l-3.2 3.2a4 4 0 0 0 5.7 5.7l1.2-1.2"/></symbol>
<symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4.5 4.5V21H6Z"/><path d="M14 3v4.5h4.5M9 12h6M9 15.5h6"/></symbol>
<symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 5 5.5v6c0 4.5 3 8 7 9.5 4-1.5 7-5 7-9.5v-6Z"/><path d="m9 12 2.2 2.2L15 10.4"/></symbol>
<symbol id="i-book" viewBox="0 0 24 24"><path d="M12 6.5C10 5 7.5 4.5 3.5 4.5v14c4 0 6.5.5 8.5 2 2-1.5 4.5-2 8.5-2v-14c-4 0-6.5.5-8.5 2Zm0 0v14"/></symbol>
<symbol id="i-repeat" viewBox="0 0 24 24"><path d="M17 2.5 20.5 6 17 9.5"/><path d="M3.5 11V9.5A3.5 3.5 0 0 1 7 6h13.5M7 21.5 3.5 18 7 14.5"/><path d="M20.5 13v1.5A3.5 3.5 0 0 1 17 18H3.5"/></symbol>
<symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.2"/></symbol>
</defs></svg>
<a class="skip" href="#daftar">Langsung ke formulir pendaftaran</a>

<header class="top">
  <div class="wrap">
    
    <a href="#atas" aria-label="JAGATRIP, kembali ke atas"><img src="/images/batch2/logo.webp" alt="JAGATRIP" width="132" height="36"></a>
    <nav aria-label="Navigasi halaman">
      <a href="#program">Program</a>
      <a href="#manfaat">Manfaat</a>
      <a href="#biaya">Biaya</a>
      <a href="#faq">FAQ</a>
      <a class="btn" href="#daftar">Daftar</a>
    </nav>
  </div>
</header>

<main id="atas">
<section class="hero">
  <svg class="hero-wave" viewBox="0 0 960 300" aria-hidden="true"><path d="M250 0C340 80 470 72 610 118c130 42 210 118 350 92V0Z" fill="#023175"/><path d="M180 0c120 96 290 88 430 134 130 42 210 112 350 92" fill="none" stroke="#D8AE5E" stroke-width="3"/></svg>
  <div class="wrap hero-grid">
    <div>
      <p class="partner">Indonesia–Malaysia Education Partnership</p>
      <h1><span>Sekolah &amp;</span> <span>Kampus Anda,</span>
        <span class="go">Go International!
          <svg class="swoosh" viewBox="0 0 600 16" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M3 11C150 2 420 2 597 8"/></svg>
        </span></h1>
      <p class="sub">Penjajakan kerja sama pendidikan langsung di kampus Malaysia</p>
      <p class="lede">Pimpinan sekolah, perguruan tinggi, dan yayasan bertemu pengelola kampus, melihat fasilitasnya, lalu membahas program yang dapat dijalankan bersama institusi Anda.</p>
      <dl class="facts">
        <div><dt>Tanggal</dt><dd>11–14 Januari 2027</dd></div>
        <div><dt>Tujuan</dt><dd>Malaysia</dd></div>
      </dl>
      <div class="actions">
        <a class="btn" href="#daftar">Daftarkan institusi Anda</a>
        <a class="link" href="#program">Lihat program kerja sama</a>
      </div>
    </div>
    <div class="stack">
      <button type="button" class="flyer" id="flyerFlip" aria-pressed="false" aria-label="Tukar flyer JAGATRIP ke depan">
        <img class="flyer-card f1" src="/images/batch2/flyer-front.png" width="1000" height="1250" alt="Flyer Sekolah dan Kampus Anda, Go International: jajaki peluang kerja sama pendidikan dengan University of Cyberjaya, Asia Metropolitan University, dan TAR UMT" loading="eager">
        <img class="flyer-card f2" src="/images/batch2/flyer-back.png" width="640" height="800" alt="Flyer Belajar Langsung di Malaysia, program kunjungan akademik dan pengalaman kampus internasional" loading="eager">
      </button>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="latar-h">
  <div class="wrap why">
    <div>
      <h2 id="latar-h">Jejaring internasional kini ikut menentukan cara institusi dinilai</h2>
      <p class="lede">Orang tua, calon mahasiswa, dan asesor ingin melihat kerja sama yang benar-benar berjalan.</p>
    </div>
    <ul class="why-list">
      <li><h3>Persaingan makin terlihat</h3><p>Orang tua makin selektif. Mereka membandingkan program, reputasi, dan arah lulusan sebelum memilih.</p></li>
      <li><h3>Mutu perlu bukti</h3><p>Akreditasi dan penilaian kinerja membutuhkan kegiatan yang terdokumentasi, bukan sekadar naskah kerja sama.</p></li>
      <li><h3>Pintu masuknya tidak selalu jelas</h3><p>Menghubungi kampus luar negeri sendiri memakan waktu: siapa yang dituju, program apa yang tersedia, dan apa syaratnya.</p></li>
    </ul>
  </div>
</section>

<section class="sec about" aria-labelledby="tentang-h">
  <div class="wrap">
    <h2 id="tentang-h">Kunjungan ini dirancang untuk memulai kerja sama</h2>
    <p class="lede">Program Januari mempertemukan pimpinan institusi Indonesia dengan pengelola kerja sama di kampus Malaysia. Bapak/Ibu melihat langsung lingkungan kampus, memahami bentuk kolaborasi yang tersedia, dan membicarakan kebutuhan institusi bersama pihak kampus.</p>
    <ul class="agenda">
      <li><h3>Collaboration Exposure Session</h3><p>Pemaparan bentuk kerja sama yang dapat dijalankan bersama kampus, di semua kampus kunjungan.</p></li>
      <li><h3>Dialog terbuka dengan PIC kampus</h3><p>Tanya jawab langsung dengan pihak yang menangani kerja sama.</p></li>
      <li><h3>Campus Experience</h3><p>Merasakan suasana belajar dan kehidupan kampus secara langsung.</p></li>
      <li><h3>Kunjungan fasilitas</h3><p>Ruang kelas, laboratorium, perpustakaan, dan fasilitas lain sesuai izin kampus.</p></li>
      <li><h3>Culture Exposure Session</h3><p>Mengenal budaya dan lingkungan akademik di kampus kunjungan.</p></li>
      <li><h3>Jejaring institusi</h3><p>Bertemu pimpinan pendidikan dari berbagai daerah dan mitra di Malaysia.</p></li>
    </ul>
    <p class="takeaway">Bapak/Ibu pulang dengan gambaran program yang sesuai, kontak PIC kampus, dan langkah kerja sama berikutnya.</p>
  </div>
</section>

<section class="sec prog" id="program" aria-labelledby="program-h">
  <svg class="prog-wave" viewBox="0 0 960 300" aria-hidden="true"><path d="M250 0C340 80 470 72 610 118c130 42 210 118 350 92V0Z" fill="#023175" opacity=".07"/><path d="M180 0c120 96 290 88 430 134 130 42 210 112 350 92" fill="none" stroke="#D8AE5E" stroke-width="3"/></svg>
  <div class="wrap">
    <h2 id="program-h">Program yang dapat dijajaki</h2>
    <p class="lede" style="margin-top:12px">Institusi memilih sesuai kebutuhan, bidang, dan kalender akademik. Sebagian dapat berjalan daring, sebagian tatap muka.</p>
    <div class="tabs" role="tablist" aria-label="Jenis institusi">
      <button role="tab" id="tab-s" aria-controls="panel-s" aria-selected="true" type="button"><svg class="ico" aria-hidden="true"><use href="#i-book"/></svg><span>Sekolah, madrasah, pesantren</span></button>
      <button role="tab" id="tab-p" aria-controls="panel-p" aria-selected="false" tabindex="-1" type="button"><svg class="ico" aria-hidden="true"><use href="#i-cap"/></svg><span>Perguruan tinggi</span></button>
    </div>
    <div class="panel" id="panel-s" role="tabpanel" aria-labelledby="tab-s" tabindex="0">
      <p>Program Sekolah Mitra Internasional: kerja sama kelembagaan yang berjalan bertahap, tanpa kewajiban perjalanan ke luar negeri setiap tahun.</p>
      <ul class="plist">
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-globe"/></svg></span><div><b>Global Education Insight</b><span class="d">Wawasan studi lanjut internasional bagi siswa, guru, dan orang tua.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-board"/></svg></span><div><b>International Inspiring Class</b><span class="d">Kelas inspirasi dan kuliah tamu dari narasumber internasional sesuai bidang sekolah.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-cap"/></svg></span><div><b>Student for a Day</b><span class="d">Satu hari pengalaman menjadi mahasiswa di kampus Malaysia.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-plane"/></svg></span><div><b>International Study Excursion</b><span class="d">Kunjungan belajar terstruktur ke Malaysia selama 2–5 hari.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-users"/></svg></span><div><b>Teacher &amp; Leadership Development</b><span class="d">Pengembangan guru, guru BK, dan pimpinan sekolah.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-compass"/></svg></span><div><b>Student Career Guidance</b><span class="d">Bimbingan karier siswa dengan materi dan narasumber bagi guru BK.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-route"/></svg></span><div><b>Graduate Pathway Support</b><span class="d">Pendampingan jalur studi dan dokumen aplikasi bagi lulusan.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-home"/></svg></span><div><b>Parent Class</b><span class="d">Informasi biaya, keamanan, dan proses studi bagi orang tua.</span></div></li>
      </ul>
      <p class="callout"><svg class="ico" aria-hidden="true"><use href="#i-case"/></svg><span>Untuk SMK, program dapat disesuaikan dengan bidang kesehatan, farmasi, bisnis, teknologi informasi, dan teknik.</span></p>
    </div>
    <div class="panel alt" id="panel-p" role="tabpanel" aria-labelledby="tab-p" tabindex="0" hidden>
      <p>Program One University: satu siklus kolaborasi internasional setiap tahun, dimulai dari kegiatan ringan lalu diperdalam sesuai kesiapan institusi.</p>
      <ul class="plist">
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-bank"/></svg></span><div><b>Academic Visit &amp; Campus Benchmarking</b><span class="d">Mempelajari tata kelola, kurikulum, dan laboratorium kampus mitra.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-chat"/></svg></span><div><b>Joint Seminar, Webinar &amp; Conference</b><span class="d">Forum akademik bersama, daring maupun luring.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-award"/></svg></span><div><b>Academic Leadership Development</b><span class="d">Pengembangan rektorat, dekanat, pengelola prodi, dan penjaminan mutu.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-board"/></svg></span><div><b>Guest Lecture &amp; Visiting Professor</b><span class="d">Kuliah tamu dan dosen tamu internasional.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-swap"/></svg></span><div><b>Student Mobility</b><span class="d">Pertukaran satu semester dan program singkat mahasiswa.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-map"/></svg></span><div><b>International KKL &amp; Study Visit</b><span class="d">Pembelajaran lapangan terstruktur selama 3, 5, atau 7 hari.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-case"/></svg></span><div><b>Internship &amp; Community Engagement</b><span class="d">Magang dan pengabdian masyarakat lintas negara.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-flask"/></svg></span><div><b>Research Collaboration &amp; Joint Publication</b><span class="d">Forum penjajakan riset dan publikasi bersama.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-badge"/></svg></span><div><b>Accreditation &amp; Curriculum Benchmarking</b><span class="d">Benchmarking kurikulum dan penyiapan portofolio akreditasi internasional.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-link"/></svg></span><div><b>Joint/Double Degree &amp; Articulation</b><span class="d">Perintisan gelar bersama atau artikulasi sesuai regulasi.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-cap"/></svg></span><div><b>Postgraduate &amp; Doctoral Pathway</b><span class="d">Jalur studi lanjut S2–S3 bagi dosen dan tenaga kependidikan.</span></div></li>
        <li><span class="tile"><svg class="ico" aria-hidden="true"><use href="#i-doc"/></svg></span><div><b>MoU/PKS Facilitation</b><span class="d">Penyusunan payung kerja sama kelembagaan.</span></div></li>
      </ul>
    </div>
    <p class="fine">Sertifikat resmi, akses laboratorium, beasiswa atau keringanan biaya, dan articulation mengikuti persetujuan tertulis kampus.</p>
  </div>
</section>

<section class="sec benefit" id="manfaat" aria-labelledby="manfaat-h">
  <svg class="prog-wave" viewBox="0 0 960 300" aria-hidden="true"><path d="M180 0c120 96 290 88 430 134 130 42 210 112 350 92" fill="none" stroke="#D8AE5E" stroke-width="3"/></svg>
  <div class="wrap" style="position:relative">
    <h2 id="manfaat-h">Manfaat bagi institusi</h2>
    <p class="lede">Manfaat terbentuk bertahap, seiring kegiatan yang dijalankan bersama kampus.</p>
    <div class="bgrid">
      <div class="bcard">
        <div class="bhead s"><svg class="ico" aria-hidden="true"><use href="#i-book"/></svg><h3>Bagi sekolah</h3></div>
        <ul class="blist">
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg></span><span>Profil mutu, reputasi, dan daya saing yang lebih kuat melalui kerja sama internasional.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-book"/></svg></span><span>Wawasan dan pengayaan akademik internasional bagi siswa.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-users"/></svg></span><span>Kompetensi dan jejaring profesional guru serta guru BK yang berkembang.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-route"/></svg></span><span>Jalur studi lanjut internasional yang jelas bagi lulusan.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-home"/></svg></span><span>Informasi yang menenangkan orang tua tentang biaya, keamanan, dan proses studi.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-repeat"/></svg></span><span>Kegiatan internasional yang berkelanjutan setiap tahun.</span></li>
        </ul>
      </div>
      <div class="bcard">
        <div class="bhead u"><svg class="ico" aria-hidden="true"><use href="#i-cap"/></svg><h3>Bagi perguruan tinggi</h3></div>
        <ul class="blist">
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-globe"/></svg></span><span>Kerja sama mitra internasional yang mendukung capaian IKU.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-swap"/></svg></span><span>Pengalaman belajar mahasiswa di luar kampus melalui mobilitas dan KKL.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-board"/></svg></span><span>Kegiatan dosen lintas negara: kuliah tamu, visiting professor, dan mobilitas.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-flask"/></svg></span><span>Kolaborasi riset dan publikasi bersama.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-badge"/></svg></span><span>Bukti dukung akreditasi nasional dan portofolio akreditasi internasional program studi.</span></li>
          <li><span class="mini"><svg class="ico" aria-hidden="true"><use href="#i-cap"/></svg></span><span>Jalur studi lanjut S2–S3 bagi dosen.</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="camp" aria-label="Kampus kunjungan">
  <div class="wrap">
    <p class="lbl">Kampus kunjungan Januari 2027</p>
    <ul>
      <li><b>University of Cyberjaya</b><span>Kesehatan, farmasi, psikologi</span></li>
      <li><b>Asia Metropolitan University</b><span>Bisnis, akuntansi, teknologi informasi</span></li>
      <li><b>TAR UMT</b><span>Akuntansi, bisnis, komputasi, teknik</span></li>
      <li class="more">dan beberapa kampus lainnya</li>
    </ul>
  </div>
</section>

<section class="sec bridge" aria-labelledby="jembatan-h">
