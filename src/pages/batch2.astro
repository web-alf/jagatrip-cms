<Footer />

<script>
(function () {
  // Pengaturan formulir
  var APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzCfieOsoJbjO6cDHYhR5LP9k9m0jDahBl2RkW--ZZbgNXSDUDXqbtANMVVNXr_uJrLoA/exec';
  var SHEET_TAB = 'Desember';
  var ADMIN_WA = '6281128506576'; // Admin Dwita
  var PROGRAM = 'Batch 2 Kemitraan Kampus Malaysia, 11-14 Januari 2027';

  // UTM
  var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];
  function captureUtm() {
    try {
      if (sessionStorage.getItem('jt_utm')) return;
      var p = new URLSearchParams(location.search), found = {}, any = false;
      UTM_KEYS.forEach(function (k) { var v = p.get(k); if (v) { found[k] = v.trim(); any = true; } });
      if (any) sessionStorage.setItem('jt_utm', JSON.stringify(found));
    } catch (e) {}
  }
  function getUtm() {
    var out = {};
    UTM_KEYS.forEach(function (k) { out[k] = ''; });
    try {
      var s = JSON.parse(sessionStorage.getItem('jt_utm') || '{}');
      UTM_KEYS.forEach(function (k) { if (typeof s[k] === 'string') out[k] = s[k]; });
    } catch (e) {}
    return out;
  }
  function normalizeWa(input) {
    var d = (input || '').replace(/[^\d+]/g, '');
    if (d.charAt(0) === '+') d = d.slice(1);
    if (d.charAt(0) === '0') d = '62' + d.slice(1);
    else if (d.charAt(0) === '8') d = '62' + d;
    return /^628\d{8,11}$/.test(d) ? d : '';
  }
  captureUtm();

  // Tab program
  var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
  function selectTab(tab, focus) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
    if (focus) tab.focus();
  }
  tabs.forEach(function (tab, i) {
    tab.addEventListener('click', function () { selectTab(tab); });
    tab.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        selectTab(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      }
    });
  });

  // Flip flyer
  var flipBtn = document.getElementById('flyerFlip');
  if (flipBtn) {
    flipBtn.addEventListener('click', function () {
      flipBtn.setAttribute('aria-pressed', flipBtn.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
    });
  }

  // Formulir
  var form = document.getElementById('regForm');
  var statusEl = document.getElementById('regStatus');
  var btn = form.querySelector('button[type="submit"]');

  function mark(input, bad) {
    input.setAttribute('aria-invalid', bad ? 'true' : 'false');
    if (bad) input.setAttribute('aria-describedby', input.id + '-err');
    else input.removeAttribute('aria-describedby');
    return bad;
  }
  ['nama', 'institusi', 'jabatan', 'alamat', 'wa'].forEach(function (id) {
    var el = document.getElementById(id);
    el.addEventListener('input', function () { if (el.getAttribute('aria-invalid') === 'true') mark(el, false); });
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var namaEl = form.elements.nama, instEl = form.elements.institusi, jabEl = form.elements.jabatan, almEl = form.elements.alamat, waEl = form.elements.wa;
    var nama = namaEl.value.trim(), institusi = instEl.value.trim(), jabatan = jabEl.value.trim(), alamat = almEl.value.trim(), wa = normalizeWa(waEl.value);
    var els = [namaEl, instEl, jabEl, almEl, waEl];
    var bad = [mark(namaEl, !nama), mark(instEl, !institusi), mark(jabEl, !jabatan), mark(almEl, !alamat), mark(waEl, !wa)];
    var firstBad = bad.indexOf(true);
    if (firstBad !== -1) { els[firstBad].focus(); return; }

    btn.disabled = true;
    btn.textContent = 'Mengirim...';

    var payload = Object.assign({
      _sheet: SHEET_TAB, nama: nama, institusi: institusi, jabatan: jabatan, alamat: alamat,
      wa: wa, minat: PROGRAM, timestamp: new Date().toISOString(), source: location.href
    }, getUtm());

    try {
      fetch(APPS_SCRIPT_URL, { method: 'POST', mode: 'no-cors', keepalive: true, body: JSON.stringify(payload) }).catch(function () {});
    } catch (err) {}
    if (window.fbq) { try { window.fbq('track', 'Lead', { content_name: 'Batch 2 Kemitraan Malaysia' }); } catch (err2) {} }

    var pesan = 'Halo Admin, saya ' + nama + ' berminat mengikuti program kemitraan Malaysia, dan sudah mengisi form. Bagaimana tahap selanjutnya?';
    var waUrl = 'https://wa.me/' + ADMIN_WA + '?text=' + encodeURIComponent(pesan);

    statusEl.hidden = false;
    statusEl.innerHTML = '';
    statusEl.appendChild(document.createTextNode('Data terkirim. Membuka WhatsApp. Bila tidak terbuka, '));
    var a = document.createElement('a');
    a.href = waUrl; a.textContent = 'ketuk di sini';
    statusEl.appendChild(a);
    statusEl.appendChild(document.createTextNode('.'));
    btn.textContent = 'Data terkirim';

    setTimeout(function () { window.location.href = waUrl; }, 600);
  });
})();
</script>
</body>
