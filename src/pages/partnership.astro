---
<!doctype html>
<html lang="id">
<head>
<meta name="theme-color" content="#0B2038">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jagatrip — Sekolah & Kampus Anda, Go International | Kemitraan Pendidikan Indonesia–Malaysia</title>
<meta name="description" content="Jalin kerja sama pendidikan internasional dengan University of Cyberjaya, Asia Metropolitan University, dan TAR UMT. Difasilitasi PT Jagatrip Mitra Edukasi.">
<link rel="icon" href="/assets/brand/logogram.webp" type="image/webp">

</head>
<body>

<!-- HEADER -->
<header>
  <div class="wrap nav">
    <a class="brand" href="#top">
      <img class="mark" src="/assets/brand/logogram.webp" alt="" width="34" height="34">
      <img class="logo" src="/assets/brand/logotype.webp" alt="Jagatrip" width="140" height="34">
      <small>Edu-Tourism · Partnership</small>
    </a>
    <nav class="nav-links">
      <a href="#kampus">Kampus Mitra</a>
      <a href="#program">Program</a>
      <a href="#alur">Cara Kerja</a>
      <a href="#faq">FAQ</a>
      <a class="btn btn-primary navcta" href="#daftar">Konsultasi Gratis <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="#2a1800" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </nav>
  </div>
</header>

<a id="top"></a>
<!-- HERO -->
<section class="hero">
  <svg class="skyline" viewBox="0 0 600 260" fill="#ffffff" aria-hidden="true">
    <rect x="40" y="150" width="34" height="110"/><rect x="84" y="110" width="40" height="150"/>
    <polygon points="150,260 150,60 165,40 180,60 180,260"/><polygon points="188,260 188,60 203,40 218,60 218,260"/>
    <rect x="235" y="120" width="30" height="140"/><rect x="275" y="90" width="44" height="170"/>
    <rect x="330" y="140" width="30" height="120"/><rect x="368" y="70" width="26" height="190"/>
    <rect x="404" y="130" width="40" height="130"/><rect x="452" y="100" width="30" height="160"/>
    <rect x="492" y="155" width="34" height="105"/>
  </svg>
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <span class="eyebrow">Indonesia&nbsp;–&nbsp;Malaysia Education Partnership</span>
        <h1>Sekolah &amp; Kampus Anda,<br><span class="go u">Go International!</span></h1>
        <p class="lead">Jalin kerja sama pendidikan dengan <b>tiga universitas terkemuka di Malaysia</b> — difasilitasi penuh oleh PT Jagatrip Mitra Edukasi. Pengalaman internasional nyata untuk siswa, guru, dosen, dan institusi Anda.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#daftar">Konsultasikan Kerja Sama Anda
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="#2a1800" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a class="btn btn-ghost" href="#program">Lihat Program</a>
        </div>
        <div class="trust">
          <span><i class="dot"></i> Mitra resmi 3 universitas Malaysia</span>
          <span><i class="dot"></i> Fleksibel: daring · hibrida · tatap muka</span>
          <span><i class="dot"></i> Pendampingan penuh</span>
        </div>
      </div>
      <div class="hero-card">
        <h4>Universitas Mitra</h4>
        <div class="camp">
          <div class="badge camp-badge-uoc">UoC</div>
          <div><b>University of Cyberjaya</b><small>Kesehatan · Farmasi · Psikologi · K3</small></div>
        </div>
        <div class="camp">
          <div class="badge camp-badge-amu">AMU</div>
          <div><b>Asia Metropolitan University</b><small>Bisnis · Akuntansi · IT · Healthcare Mgmt</small></div>
        </div>
        <div class="camp">
          <div class="badge camp-badge-tar">TAR</div>
          <div><b>TAR UMT</b><small>Terbesar · ACCA/CIMA · Articulation 2+2</small></div>
        </div>
        <div class="flagline"><i class="flag-red"></i><i class="flag-white"></i><i class="flag-red"></i><i class="flag-white"></i><i class="flag-blue"></i><i class="flag-yellow"></i></div>
      </div>
    </div>
  </div>
  <div class="partner-strip">
    <div class="wrap">
      <span>Dipercaya untuk menghubungkan: <b>Sekolah · Madrasah · Pesantren</b></span>
      <span><b>Perguruan Tinggi</b></span>
      <span><b>Yayasan Pendidikan</b></span>
    </div>
  </div>
</section>

<!-- KAMPUS -->
<section class="sec" id="kampus">
  <div class="wrap">
    <div class="center">
      <span class="kicker">Tiga Segmen, Tiga Keunggulan</span>
      <h2 class="h2 section-heading">Pilih Kampus yang Paling Cocok untuk Institusi Anda</h2>
      <p class="sub">Setiap universitas mitra memiliki keunggulan berbeda — kami mencocokkannya dengan jurusan dan kebutuhan sekolah/kampus Anda.</p>
    </div>
    <div class="grid3">
      <div class="card">
        <span class="tag tag-uoc">UoC · Kesehatan</span>
        <h3>University of Cyberjaya</h3>
        <p>Universitas Malaysia berakar kuat di bidang kesehatan, dengan laboratorium kelas dunia bersertifikat GLP.</p>
        <ul>
          <li>Farmasi, Keperawatan, Fisioterapi, Dietetika</li>
          <li>Psikologi & Kesehatan–Keselamatan Kerja (K3)</li>
          <li>Pascasarjana & ODL (MBA, MPH, PhD)</li>
        </ul>
      </div>
      <div class="card">
        <span class="tag tag-amu">AMU · Karier</span>
        <h3>Asia Metropolitan University</h3>
        <p>Universitas karier di lokasi kota — terjangkau, fleksibel, dari Foundation hingga Doktoral.</p>
        <ul>
          <li>Business, Accounting, Information Technology</li>
          <li>Healthcare Management (jalur manajerial)</li>
          <li>Future Leaders Foundation Grant &amp; MBA ODL</li>
        </ul>
      </div>
      <div class="card">
        <span class="tag tag-tar">TAR UMT · Skala</span>
        <h3>TAR UMT</h3>
        <p>Universitas swasta terbesar di Malaysia, pusat kota Kuala Lumpur, berorientasi profesi.</p>
        <ul>
          <li>Akuntansi &amp; profesi (ACCA, CIMA, CPA)</li>
          <li>Bisnis, Komputing/IT, Teknik</li>
          <li>Articulation 2+2 ke gelar UK/Australia</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="sec features">
  <div class="wrap">
    <div class="center">
      <span class="kicker kicker-accent">Apa yang Kami Tawarkan</span>
      <h2 class="h2 section-heading">Satu Kemitraan, Banyak Manfaat</h2>
      <p class="sub">Bukan sekadar nota kesepahaman — melainkan kegiatan nyata yang berjalan setiap tahun.</p>
    </div>
    <div class="grid4">
      <div class="feat">
        <div class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="9" cy="7" r="3"/><path d="M15 11a3 3 0 1 0-1.5-5.6M2 20c0-3 3-5 7-5s7 2 7 5M16 20c0-2-1-3.5-2.5-4.3"/></svg></div>
        <h4>Jejaring Pendidikan Internasional</h4>
        <p>Akses resmi ke tiga universitas Malaysia tanpa harus membangun hubungan sendiri.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg></div>
        <h4>Academic Visit &amp; Campus Experience</h4>
        <p>Kunjungan akademik & “Student for a Day” — siswa merasakan langsung kampus internasional.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M8 13a4 4 0 1 1 4-4M16 11a4 4 0 1 0-4 4"/><path d="M7 20c0-2 2-3.5 5-3.5S17 18 17 20"/></svg></div>
        <h4>Program Kolaborasi Sekolah &amp; Kampus</h4>
        <p>Webinar, kuliah tamu, kompetisi, hingga kolaborasi akademik dan articulation.</p>
      </div>
      <div class="feat">
        <div class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M9 18h6M10 21h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1h6c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2Z"/></svg></div>
        <h4>Pengembangan Guru, Dosen &amp; Siswa</h4>
        <p>Pelatihan, faculty sharing, dan jalur studi lanjut (S2/S3) bagi pendidik.</p>
      </div>
    </div>
  </div>
</section>

<!-- PROGRAM -->
<section class="sec" id="program">
  <div class="wrap">
    <div class="center">
      <span class="kicker">Program Unggulan</span>
      <h2 class="h2 section-heading">Dirancang untuk Sekolah &amp; Perguruan Tinggi</h2>
      <p class="sub">Dua jalur program — satu untuk sekolah menengah, satu untuk perguruan tinggi — dengan prinsip yang sama: pengalaman internasional nyata setiap tahun.</p>
    </div>
    <div class="prog">
      <div class="pc">
        <div class="top program-school">
          <div><div class="n">Untuk Sekolah / Madrasah</div><h3>One School</h3></div>
        </div>
        <div class="body">
          <p><b>“One School — One International Experience Per Year.”</b> Setiap tahun sekolah memiliki minimal satu pengalaman internasional.</p>
          <ul>
            <li>International University Introduction</li>
            <li>International Guest Lecture</li>
            <li>Malaysia Campus Experience / Student for a Day</li>
            <li>Teacher &amp; School Leadership Development</li>
            <li>Academic Collaboration</li>
          </ul>
        </div>
      </div>
      <div class="pc">
        <div class="top program-university">
          <div><div class="n">Untuk Perguruan Tinggi</div><h3>One University</h3></div>
        </div>
        <div class="body">
          <p><b>“One University — One International Collaboration Cycle Per Year.”</b> Satu siklus kolaborasi internasional nyata tiap tahun.</p>
          <ul>
            <li>Kerja sama fakultas &amp; kegiatan tahunan</li>
            <li>Kunjungan akademik / KKL internasional</li>
            <li>Kuliah tamu, mobilitas dosen &amp; riset</li>
            <li>Jalur studi S2–S3 (termasuk ODL)</li>
            <li>Pengelolaan program internasional terukur</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BENEFITS BAND -->
<section class="sec band">
  <div class="wrap">
    <div class="center band-heading">
      <h2 class="h2">Mengapa Indonesia–Malaysia?</h2>
      <p class="sub">Dekat secara geografis, akrab secara budaya — pilihan studi internasional yang realistis dan terjangkau bagi keluarga Indonesia.</p>
    </div>
    <div class="g">
      <div><div class="n">3</div><small>Universitas mitra resmi</small></div>
      <div><div class="n">±4,3 jt</div><small>Kunjungan Indonesia→Malaysia / tahun</small></div>
      <div><div class="n">5</div><small>Bentuk program per sekolah</small></div>
      <div><div class="n">2026–2031</div><small>Kerja sama berkelanjutan</small></div>
    </div>
  </div>
</section>

<!-- ALUR -->
<section class="sec" id="alur">
  <div class="wrap">
    <div class="center">
      <span class="kicker">Cara Kerja</span>
      <h2 class="h2 section-heading">Empat Langkah Menjadi Mitra Internasional</h2>
    </div>
    <div class="steps">
      <div class="step"><h4>Konsultasi</h4><p>Sesi perkenalan singkat (daring/luring) untuk memahami kebutuhan institusi Anda.</p></div>
      <div class="step"><h4>Nota Kesepahaman</h4><p>Penandatanganan MoU Sekolah/Kampus × Universitas Mitra sebagai kerangka kerja sama.</p></div>
      <div class="step"><h4>Kegiatan Tahunan</h4><p>Webinar, kuliah tamu, campus experience, hingga pendampingan aplikasi.</p></div>
      <div class="step"><h4>Evaluasi &amp; Skala</h4><p>Tinjauan tahunan dan peningkatan kemitraan sesuai keaktifan.</p></div>
    </div>
  </div>
</section>

<!-- AUDIENCE -->
<section class="sec aud">
  <div class="wrap">
    <div class="center">
      <span class="kicker">Program Untuk</span>
      <h2 class="h2 section-heading">Siapa yang Dapat Bermitra</h2>
    </div>
    <div class="aud-grid">
      <div class="aud-card"><h4>Sekolah, Madrasah &amp; Pesantren</h4><p>SMA/MA, SMK (Kesehatan, Bisnis, IT, Teknik), dan pesantren modern yang ingin membuka wawasan internasional siswa.</p></div>
      <div class="aud-card"><h4>Perguruan Tinggi</h4><p>Universitas, institut, sekolah tinggi, politeknik, dan STIKES untuk kolaborasi fakultas, riset, dan mobilitas.</p></div>
      <div class="aud-card"><h4>Yayasan Pendidikan</h4><p>Pengelola yayasan yang ingin meningkatkan mutu, akreditasi, dan jejaring internasional lembaganya.</p></div>
    </div>
  </div>
</section>

<!-- CTA / FORM -->
<section class="sec cta" id="daftar">
  <div class="wrap">
    <div class="cta-grid">
      <div>
        <h2>Mulai Kerja Sama Anda Hari Ini</h2>
        <p>Jadwalkan konsultasi gratis. Tim kami akan menjelaskan program, menyesuaikan dengan institusi Anda, dan mengirim proposal lengkap.</p>
        <ul class="points">
          <li>Konsultasi gratis, tanpa kewajiban</li>
          <li>Proposal &amp; draf MoU dikirim langsung</li>
          <li>Pendampingan dari perencanaan hingga pelaksanaan</li>
        </ul>
      </div>
      <form class="form" id="leadForm" >
        <h3>Konsultasikan Kerja Sama Anda</h3>
        <div class="mut">Isi data singkat — kami hubungi Anda via WhatsApp.</div>
        <div class="field"><label for="nama">Nama Lengkap *</label><input required name="nama" placeholder="Nama Anda" id="nama" type="text" autocomplete="name"></div>
        <div class="field"><label for="institusi">Nama Institusi *</label><input required name="institusi" placeholder="Sekolah / Kampus / Yayasan" id="institusi" type="text" autocomplete="organization"></div>
        <div class="row2">
          <div class="field"><label for="jabatan">Jabatan</label><input name="jabatan" placeholder="Kepala Sekolah / Dekan / dll" id="jabatan" type="text" autocomplete="organization-title"></div>
          <div class="field"><label for="kota">Kota</label><input name="kota" placeholder="Kota institusi" id="kota" type="text" autocomplete="address-level2"></div>
        </div>
        <div class="row2">
          <div class="field"><label for="jenis">Jenis Institusi *</label>
            <select required name="jenis" id="jenis">
              <option value="">Pilih…</option>
              <option>Sekolah / Madrasah / Pesantren</option>
              <option>Perguruan Tinggi</option>
              <option>Yayasan Pendidikan</option>
            </select>
          </div>
          <div class="field"><label for="wa">No. WhatsApp *</label><input required name="wa" placeholder="08xxxxxxxxxx" inputmode="tel" id="wa" type="tel" autocomplete="tel"></div>
        </div>
        <div class="field"><label for="minat">Minat Program</label>
          <select name="minat" id="minat">
            <option value="">(opsional)</option>
            <option>One School (Sekolah)</option>
            <option>One University (Perguruan Tinggi)</option>
            <option>Campus Experience / Study Visit</option>
            <option>Rekrutmen / Studi Lanjut</option>
            <option>Belum tahu — ingin berdiskusi</option>
          </select>
        </div>
        <button class="btn btn-primary" type="submit"><span class="wa"><svg width="19" height="19" viewBox="0 0 24 24" fill="#2a1800"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.8-4.2-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2 .9.5 1.2.6 1.5.4.3-.2.5-.6.7-.9.1-.2.3-.2.5-.1l1.9.9c.2.1.4.2.4.3.1.2.1.6-.1 1.1Z"/></svg> Kirim via WhatsApp</span></button>
        <div class="fine">Dengan mengirim, Anda setuju dihubungi tim Jagatrip. Data Anda kami jaga kerahasiaannya.</div>
      </form>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="sec faq-section" id="faq">
  <div class="wrap">
    <div class="center faq-heading">
      <span class="kicker">Pertanyaan Umum</span>
      <h2 class="h2 section-heading">Hal yang Sering Ditanyakan</h2>
    </div>
    <details open><summary>Apakah kerja sama ini mewajibkan perjalanan ke luar negeri?</summary><p>Tidak. Program bersifat fleksibel — dapat berupa kegiatan daring, hibrida, atau tatap muka. Sekolah memilih bentuk yang paling sesuai dengan kebutuhan dan anggarannya.</p></details>
    <details><summary>Apa manfaatnya bagi akreditasi sekolah/kampus?</summary><p>Kerja sama internasional, pengembangan guru/dosen, dan pengalaman siswa adalah bukti nyata yang dapat memperkuat profil mutu dan mendukung penilaian akreditasi, sesuai instrumen yang berlaku.</p></details>
    <details><summary>Siapa yang memfasilitasi dan mendampingi?</summary><p>PT Jagatrip Mitra Edukasi memfasilitasi komunikasi dengan universitas, perencanaan program, koordinasi kegiatan & delegasi, serta pelaporan — dengan pendampingan penuh.</p></details>
    <details><summary>Apakah ada sertifikat, beasiswa, atau akses laboratorium?</summary><p>Fasilitas resmi tertentu (sertifikat, akses lab, beasiswa/keringanan, articulation/credit transfer) tersedia namun mengikuti persetujuan tertulis universitas. Kami tidak menjanjikan hal yang belum disetujui.</p></details>
    <details><summary>Bagaimana cara memulai?</summary><p>Isi formulir di atas atau hubungi kami via WhatsApp. Kami akan menjadwalkan sesi perkenalan singkat dan mengirimkan proposal program serta draf MoU.</p></details>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <div class="brand">
          <img class="mark footer-mark" src="/assets/brand/logogram.webp" alt="" width="32" height="32">
          <img class="logo footer-logo" src="/assets/brand/logotype.webp" alt="Jagatrip" width="130" height="32">
        </div>
        <p>PT Jagatrip Mitra Edukasi — menghubungkan pendidikan Indonesia dengan dunia melalui kemitraan, kunjungan akademik, dan pengembangan institusi.</p>
      </div>
      <div>
        <h5>Navigasi</h5>
        <a href="#kampus">Kampus Mitra</a>
        <a href="#program">Program</a>
        <a href="#alur">Cara Kerja</a>
        <a href="#faq">FAQ</a>
      </div>
      <div>
        <h5>Kontak</h5>
        <a href="https://wa.me/628139190363" target="_blank" rel="noopener">WhatsApp: +62 813 9190 363</a>
        <a href="mailto:official@jagatrip.com">official@jagatrip.com</a>
        <a href="#top">jagatrip.com</a>
        <span class="contact-address">Jl. Bangetayu Kulon No.216D, Semarang, Jawa Tengah</span>
      </div>
    </div>
    <p class="note">Catatan: PT Jagatrip Mitra Edukasi bertindak sebagai fasilitator kemitraan. Fasilitas resmi (sertifikat, akses laboratorium, beasiswa/keringanan, articulation/credit transfer) mengikuti persetujuan tertulis universitas mitra dan dapat berubah sewaktu-waktu.</p>
    <div class="copyright">© 2026 PT Jagatrip Mitra Edukasi · Indonesia–Malaysia Education Partnership</div>
  </div>
</footer>

  <script>
  // Kirim data formulir ke Google Sheet (tab Partnership), lalu arahkan ke WA admin
  const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzBsDeaozJ-mX0i2UfV4L6j0RsDilXyV78wTjZtLQeyX2AztLRvwwYQG47JYiiiLhQKoQ/exec";
  const ADMIN_WA = "6281128506576"; // Admin Dwita

  const leadForm = document.querySelector("#leadForm");

  leadForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!leadForm.reportValidity()) return;

    const data = new FormData(leadForm);
    const field = (name) => String(data.get(name) ?? "").trim();
    const fallback = (name) => field(name) || "-";
    const nama = field("nama");

    const payload = {
      _sheet: "Partnership",
      nama,
      institusi: field("institusi"),
      jabatan: fallback("jabatan"),
      kota: fallback("kota"),
      jenis: field("jenis"),
      wa: field("wa"),
      minat: fallback("minat"),
      timestamp: new Date().toISOString(),
      source: window.location.href,
    };

    fetch(APPS_SCRIPT_URL, {
      method: "POST",
      mode: "no-cors",
      body: JSON.stringify(payload),
    }).catch(() => {});

    const message = `Halo Admin, saya ${nama} ingin bermitra dengan kampus LN dan sudah mengisi form. Bagaimana selanjutnya?`;

    const link = document.createElement("a");
    link.href = `https://wa.me/${ADMIN_WA}?text=${encodeURIComponent(message)}`;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    document.body.append(link);
    link.click();
    link.remove();
  });

  // Animasi masuk saat elemen terlihat
  if (
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const items = document.querySelectorAll(".card, .feat, .pc, .step, .aud-card");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    items.forEach((element) => {
      element.classList.add("will-reveal");
      observer.observe(element);
    });
  }
</script>
</body>
</html>
