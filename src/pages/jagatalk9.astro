<script>
  const registrationForm = document.querySelector<HTMLFormElement>('#registration-form');
  const navToggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');

  function closeMobileMenu() {
    if (!navToggle || !mobileMenu) return;
    navToggle.setAttribute('aria-expanded', 'false');
    navToggle.setAttribute('aria-label', 'Buka menu navigasi');
    mobileMenu.hidden = true;
  }

  navToggle?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const open = navToggle.getAttribute('aria-expanded') !== 'true';
    navToggle.setAttribute('aria-expanded', String(open));
    navToggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
    mobileMenu.hidden = !open;
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobileMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileMenu();
  });

  window.matchMedia('(min-width: 769px)').addEventListener('change', (event) => {
    if (event.matches) closeMobileMenu();
  });

  registrationForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!registrationForm.reportValidity()) return;

    const data = new FormData(registrationForm);
    const nama = String(data.get('nama') ?? '').trim().replace(/\s+/g, ' ');
    const institusi = String(data.get('institusi') ?? '').trim();
    const jabatan = String(data.get('jabatan') ?? '').trim();
    const whatsapp = String(data.get('whatsapp') ?? '').trim();
    const paket = String(data.get('paket') ?? '').trim();
    if (!nama) return;

    // Kirim ke Google Apps Script -> Google Sheet "Jagatalk9" sebelum redirect WA.
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwppLEBGL0_0FeITEjw_FD3Og8JEZQ7HjGcK5cnccQoIzkDxvYdzuToVMcZBDKRi8Np6A/exec';
    try {
      const params = new URLSearchParams(window.location.search);
      fetch(APPS_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _sheet: 'Jagatalk9',
          nama,
          sekolah: institusi,
          jabatan,
          wa: whatsapp,
          catatan: `Paket: ${paket}`,
          source: 'JAGATALK #9 Landing Page (/jagatalk9)',
          timestamp: new Date().toISOString(),
          utm_source: params.get('utm_source') || '',
          utm_medium: params.get('utm_medium') || '',
          utm_campaign: params.get('utm_campaign') || '',
          utm_term: params.get('utm_term') || '',
          utm_content: params.get('utm_content') || '',
          gclid: params.get('gclid') || '',
          fbclid: params.get('fbclid') || ''
        })
      }).catch((err) => console.error('Webhook error:', err));
    } catch (err) {
      console.error('Fetch error:', err);
    }

    const message = `Halo Admin, saya ${nama} ingin mengikuti Webinar Jagatalk Roadmap Sekolah dan sudah mengisi form. Bagaimana selanjutnya?`;
    const url = `https://wa.me/6281128506576?text=${encodeURIComponent(message)}`;

    // Redirect to WhatsApp with the user's name in a prefilled message.
    // The visitor must still press Send in WhatsApp; no form data is stored here.
    window.location.assign(url);
  });
</script>

