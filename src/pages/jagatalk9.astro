/* =========================================
   HERO GRID - PERBESAR AREA FLYER
========================================= */

.hero-grid {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  gap: clamp(24px, 3vw, 48px);
  align-items: center;
}

.hero-content {
  min-width: 0;
}

/* =========================================
   FLYER CONTAINER
========================================= */

.flyer-container {
  position: relative;
  width: 100%;
  max-width: 650px;
  margin: 0 auto;

  /* Ruang khusus untuk floating badge */
  padding: 44px 28px 48px;
  box-sizing: border-box;
}

/* Dekorasi belakang flyer */
.flyer-container::before {
  content: "";
  position: absolute;
  top: 56px;
  left: 42px;
  right: 12px;
  bottom: 24px;

  background: var(--orange);
  opacity: 0.13;
  border-radius: 16px;
  z-index: -1;
  pointer-events: none;
}

/* =========================================
   FLYER CARD
========================================= */

.flyer-placeholder {
  position: relative;
  z-index: 2;

  display: block;
  width: 100%;
  height: auto;
  padding: 0;
  overflow: hidden;

  border-radius: 12px;
  background: var(--navy);

  transform: rotate(-1deg);
  box-shadow: 0 24px 55px rgba(15, 37, 71, 0.25);

  transition: transform 0.3s ease;
}

.flyer-placeholder .ph-icon {
  display: block;
  width: 100%;
  height: auto;
  margin: 0;
  padding: 0;
}

.flyer-placeholder .ph-icon img {
  display: block;
  width: 100%;
  height: auto;
  max-width: 100%;
  object-fit: contain;
}

/* Hapus dekorasi yang menutupi gambar */
.flyer-placeholder::before,
.flyer-placeholder::after {
  display: none;
}

@media (hover: hover) {
  .flyer-placeholder:hover {
    transform: rotate(0deg) scale(1.01);
  }
}

/* =========================================
   FLOATING BADGE
========================================= */

.flyer-tag {
  position: absolute;
  z-index: 5;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 9px 15px;
  border-radius: 8px;

  background: white;
  color: var(--navy);

  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;

  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
}

/* Badge atas: di area kosong atas flyer */
.flyer-tag.tag-top {
  top: 2px;
  left: 28px;
  transform: rotate(-3deg);
}

/* Badge bawah: di area kosong bawah flyer */
.flyer-tag.tag-bot {
  bottom: 2px;
  right: 28px;
  transform: rotate(3deg);
}

/* =========================================
   TABLET
========================================= */

@media (max-width: 900px) {
  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }

  .flyer-container {
    max-width: 600px;
    padding: 42px 24px 46px;
  }

  .flyer-tag.tag-top {
    left: 24px;
  }

  .flyer-tag.tag-bot {
    right: 24px;
  }
}

/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {
  .flyer-container {
    max-width: 100%;
    padding: 40px 12px 42px;
  }

  .flyer-placeholder {
    border-radius: 10px;
    transform: none;
  }

  .flyer-tag {
    padding: 7px 10px;
    font-size: 10px;
    border-radius: 6px;
  }

  .flyer-tag.tag-top {
    top: 4px;
    left: 12px;
    transform: none;
  }

  .flyer-tag.tag-bot {
    bottom: 4px;
    right: 12px;
    transform: none;
  }

  .flyer-container::before {
    top: 50px;
    left: 24px;
    right: 0;
    bottom: 30px;
  }
}

/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 380px) {
  .flyer-container {
    padding: 36px 8px 38px;
  }

  .flyer-tag {
    font-size: 9px;
    padding: 6px 9px;
  }

  .flyer-tag.tag-top {
    left: 8px;
  }

  .flyer-tag.tag-bot {
    right: 8px;
  }
}


/* Gelembung teks lebih besar */
.flyer-tag {
  padding: 14px 22px;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.5px;
  gap: 10px;
  border-radius: 10px;
  white-space: nowrap;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

/* Titik indikator lebih besar */
.flyer-tag .dot {
  width: 11px;
  height: 11px;
  flex-shrink: 0;
}

/* Beri ruang agar tidak menutupi gambar */
.flyer-container {
  padding-top: 60px;
  padding-bottom: 60px;
}

.flyer-tag.tag-top {
  top: 5px;
  left: 28px;
}

.flyer-tag.tag-bot {
  bottom: 5px;
  right: 28px;
}

/* Tablet */
@media (max-width: 900px) {
