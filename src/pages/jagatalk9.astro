---
// Satu file Astro untuk seluruh landing page JAGATALK #9.
const pageTitle = 'JAGATALK #9 — Reposisi Sekolah: dari Potensi menjadi Reputasi';
const pageDescription = 'Framework strategis untuk pengelola sekolah yang serius membangun institusi berdaya saing. Bersama Dedi Gunawan, 30 Oktober 2026.';
---
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{pageTitle}</title>
<link rel="icon" type="image/png" href="/images/logo-icon.webp">
<link rel="apple-touch-icon" href="/images/logo-icon.webp">
<meta name="description" content={pageDescription}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
:root {
  --cream: #F5EFE4;
  --cream-dark: #ECE3D1;
  --cream-light: #FAF6ED;
  --cream-deep: #E8DCC2;
  --navy: #0F2547;
  --navy-light: #1E3A6B;
  --navy-deep: #081832;
  --orange: #E85D1F;
  --orange-dark: #C94810;
  --orange-light: #FFF3E8;
  --gold: #C9A24A;
  --gold-light: #E6CC87;
  --text: #1A1A1A;
  --text-muted: #5A5A5A;
  --border: #E0D5BE;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--text);
  background: var(--cream);
  line-height: 1.65;
  overflow-x: hidden;
}

h1, h2, h3, h4 {
  font-family: 'Playfair Display', Georgia, serif;
  color: var(--navy);
  letter-spacing: -0.5px;
  line-height: 1.15;
}

.container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ============ DECORATIVE ============ */
.deco-line {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}
.deco-line::before, .deco-line::after {
  content: '';
  width: 40px;
  height: 2px;
  background: var(--orange);
}
.deco-line .text {
  color: var(--orange);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
}

/* ============ NAVBAR ============ */

/* ==========================================
   NAVBAR
========================================== */

.navbar {
  position: sticky;
  top: 0;
  z-index: 1000;

  width: 100%;
  padding: 14px 0;

  background: rgba(245, 239, 228, 0.92);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);

  border-bottom: 1px solid rgba(224, 213, 190, 0.5);

  transition:
    background 0.3s ease,
    box-shadow 0.3s ease;
}

/* Navbar Container */
.navbar .inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  box-sizing: border-box;
}

/* ==========================================
   LOGO IMAGE
========================================== */

.navbar-logo {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;

  flex-shrink: 0;
  min-width: 0;

  text-decoration: none;
}

.navbar-logo img {
  display: block;

  width: 160px;
  max-width: 100%;
  height: auto;
  max-height: 54px;

  object-fit: contain;
  object-position: left center;

  transition: transform 0.3s ease;
}

@media (hover: hover) {
  .navbar-logo:hover img {
    transform: scale(1.03);
  }
}

/* ==========================================
   CTA BUTTON
========================================== */

.nav-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;
  min-height: 44px;
  padding: 10px 24px;

  background: var(--orange, #e85d1f);
  color: white;

  border-radius: 10px;
  text-decoration: none;

  font-family: "Inter", sans-serif;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;

  box-shadow: 0 4px 12px rgba(232, 93, 31, 0.25);

  transition:
    background 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

@media (hover: hover) {
  .nav-cta:hover {
    background: var(--orange-dark, #c94c16);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(232, 93, 31, 0.35);
  }
}

.nav-cta:focus-visible,
.navbar-logo:focus-visible {
  outline: 3px solid var(--navy, #0f2547);
  outline-offset: 4px;
}

/* ==========================================
   TABLET (max-width: 992px)
========================================== */

@media (max-width: 992px) {
  .navbar {
    padding: 12px 0;
  }

  .navbar .inner {
    padding: 0 24px;
    gap: 16px;
  }

  .navbar-logo img {
    width: 145px;
    max-height: 50px;
  }

  .nav-cta {
    padding: 10px 20px;
    font-size: 13px;
  }
}

/* ==========================================
   MOBILE (max-width: 600px)
========================================== */

@media (max-width: 600px) {
  .navbar {
    padding: 10px 0;
  }

  .navbar .inner {
    padding: 0 16px;
    gap: 12px;
  }

  .navbar-logo img {
    width: 120px;
    max-height: 44px;
  }

  .nav-cta {
    min-height: 40px;
    padding: 10px 16px;
    font-size: 12px;
  }
}

/* ==========================================
   SMALL MOBILE (max-width: 380px)
========================================== */

@media (max-width: 380px) {
  .navbar {
    padding: 9px 0;
  }

  .navbar .inner {
    padding: 0 12px;
    gap: 8px;
  }

  .navbar-logo img {
    width: 100px;
    max-height: 38px;
  }

  .nav-cta {
    min-height: 38px;
    padding: 9px 12px;
    font-size: 11px;
  }
}

.navbar-batch {
  font-family: "Inter", sans-serif;
  font-size: 15px;
  font-weight: 600;
  color: var(--text-muted, #64748b);
  white-space: nowrap;
}


/* ==========================================
   ACCESSIBILITY
========================================== */

@media (prefers-reduced-motion: reduce) {
  .navbar,
  .navbar-logo img,
  .nav-cta {
    transition: none;
  }

  .navbar-logo:hover img,
  .nav-cta:hover {
    transform: none;
  }

  .navbar-batch {
    font-size: 11px;
  }
}


/* ============ HERO ============ */
.hero {
  background: var(--cream);
  padding: 60px 0 100px;
  position: relative;
  overflow: hidden;
}

/* Decorative shapes */
.hero-shape {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
}
.shape-1 {
  top: -120px; right: -80px;
  width: 450px; height: 450px;
  background: radial-gradient(circle, rgba(232, 93, 31, 0.1) 0%, transparent 70%);
}
.shape-2 {
  bottom: -200px; left: -150px;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(15, 37, 71, 0.07) 0%, transparent 70%);
}
.shape-3 {
  top: 40%; right: 55%;
  width: 180px; height: 180px;
  background: radial-gradient(circle, rgba(201, 162, 74, 0.12) 0%, transparent 70%);
}

/* Grid pattern */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(15, 37, 71, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15, 37, 71, 0.025) 1px, transparent 1px);
  background-size: 48px 48px;
  z-index: 0;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 70px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: white;
  color: var(--navy);
  padding: 8px 18px;
  border-radius: 50px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2.5px;
  margin-bottom: 28px;
  box-shadow: 0 4px 16px rgba(15, 37, 71, 0.08);
  border: 1px solid var(--border);
}
.hero-badge::before {
  content: '';
  width: 7px; height: 7px;
  background: var(--orange);
  border-radius: 50%;
  animation: pulse 2s infinite;
  box-shadow: 0 0 0 0 rgba(232, 93, 31, 0.6);
  animation: pulseRing 1.8s infinite;
}
@keyframes pulseRing {
  0% { box-shadow: 0 0 0 0 rgba(232, 93, 31, 0.6); }
  100% { box-shadow: 0 0 0 8px rgba(232, 93, 31, 0); }
}

.hero h1 {
  font-size: 56px;
  font-weight: 800;
  margin-bottom: 20px;
}
.hero h1 .colon {
  color: var(--orange);
  font-weight: 700;
}
.hero h1 .highlight {
  color: var(--orange);
  font-style: italic;
  font-weight: 800;
  position: relative;
  display: inline-block;
}
.hero h1 .highlight::after {
  content: '';
  position: absolute;
  bottom: 6px; left: 0;
  width: 100%; height: 8px;
  background: var(--gold-light);
  opacity: 0.4;
  z-index: -1;
  border-radius: 4px;
}

.hero-sub1 {
  font-size: 19px;
  color: var(--navy);
  margin-bottom: 14px;
  font-weight: 500;
  max-width: 560px;
  line-height: 1.5;
}
.hero-sub2 {
  font-size: 15px;
  color: var(--text-muted);
  margin-bottom: 36px;
  font-style: italic;
  max-width: 560px;
  padding-left: 16px;
  border-left: 3px solid var(--orange);
  line-height: 1.55;
}

.hero-meta {
  display: flex;
  gap: 20px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: white;
  padding: 12px 18px;
  border-radius: 12px;
  box-shadow: 0 2px 10px rgba(15, 37, 71, 0.06);
  border: 1px solid var(--border);
  transition: transform 0.2s;
}
.meta-item:hover { transform: translateY(-2px); }
.meta-item .icon {
  width: 38px; height: 38px;
  background: var(--orange-light);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.meta-item .icon svg { width: 20px; height: 20px; fill: var(--orange); }
.meta-item .text { font-size: 13px; }
.meta-item .text .label {
  color: var(--text-muted);
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
}
.meta-item .text .val {
  color: var(--navy);
  font-weight: 700;
  font-size: 14px;
}

.cta-row {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
}
.cta-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--orange);
  color: white;
  padding: 17px 36px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 600;
  font-size: 16px;
  box-shadow: 0 10px 28px rgba(232, 93, 31, 0.35);
  transition: all 0.3s;
}
.cta-primary::after {
  content: '→';
  font-size: 18px;
  transition: transform 0.3s;
}
.cta-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 36px rgba(232, 93, 31, 0.45);
}
.cta-primary:hover::after { transform: translateX(4px); }

.cta-ghost {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--navy);
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  padding: 10px 0;
  border-bottom: 2px solid var(--navy);
}
.cta-ghost:hover { color: var(--orange); border-color: var(--orange); }

/* Flyer */

/* ========================================
   FLYER CONTAINER
======================================== */

.flyer-container {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  padding: 20px 24px 30px;

  box-sizing: border-box;
}

/* Decorative background */
.flyer-container::before {
  content: "";
  position: absolute;

  top: 36px;
  left: 36px;
  right: 8px;
  bottom: 12px;

  background: var(--orange);
  opacity: 0.15;
  border-radius: 20px;

  z-index: -1;
  pointer-events: none;
}

/* ========================================
   FLYER CARD
======================================== */

.flyer-placeholder {
  position: relative;
  z-index: 2;

  width: 100%;
  height: auto;
  padding: 0;

  display: block;
  overflow: hidden;

  border-radius: 20px;
  background: var(--navy);

  box-shadow:
    0 24px 60px rgba(15, 37, 71, 0.25);

  transform: rotate(-2deg);
  transform-origin: center center;

  transition:
    transform 0.4s ease,
    box-shadow 0.4s ease;
}

/* Hover only on pointer devices */
@media (hover: hover) {
  .flyer-placeholder:hover {
    transform: rotate(0deg) scale(1.01);

    box-shadow:
      0 30px 70px rgba(15, 37, 71, 0.3);
  }
}

/* ========================================
   RESPONSIVE IMAGE WRAPPER
======================================== */

.flyer-placeholder .ph-icon {
  position: relative;
  z-index: 2;

  display: block;

  width: 100%;
  height: auto;
  max-width: 100%;

  padding: 0;
  margin: 0;

  border: none;
  border-radius: inherit;

  overflow: hidden;
}

/* Image fills card width */
.flyer-placeholder .ph-icon img {
  display: block;

  width: 100%;
  max-width: 100%;
  height: auto;

  object-fit: contain;
  object-position: center;

  border-radius: inherit;
}

/* ========================================
   FLOATING TAGS
======================================== */

.flyer-tag {
  position: absolute;
  z-index: 10;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  max-width: calc(100% - 20px);

  padding: 10px 18px;

  background: #fff;
  color: var(--navy);

  border-radius: 50px;

  font-family: "Inter", sans-serif;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.4px;
  white-space: nowrap;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.15);
}

.flyer-tag .dot {
  display: block;
  flex-shrink: 0;

  width: 8px;
  height: 8px;

  border-radius: 50%;
}

/* Top Badge */
.flyer-tag.tag-top {
  top: 42px;
  left: 0;

  transform: rotate(-6deg);
}

.flyer-tag.tag-top .dot {
  background: #4a8c4a;
}

/* Bottom Badge */
.flyer-tag.tag-bot {
  bottom: 64px;
  right: 0;

  transform: rotate(4deg);
}

.flyer-tag.tag-bot .dot {
  background: var(--orange);
}

/* ========================================
   TABLET <= 768px
======================================== */

@media (max-width: 768px) {
  .flyer-container {
    max-width: 460px;
    padding: 18px 22px 28px;
  }

  .flyer-placeholder {
    border-radius: 18px;
    transform: rotate(-1.5deg);
  }

  .flyer-tag {
    padding: 9px 15px;
    font-size: 11px;
  }

  .flyer-tag.tag-top {
    top: 34px;
    left: 0;
  }

  .flyer-tag.tag-bot {
    bottom: 52px;
    right: 0;
  }
}

/* ========================================
   MOBILE <= 480px
======================================== */

@media (max-width: 480px) {
  .flyer-container {
    width: 100%;
    max-width: 100%;

    padding: 18px 14px 24px;
  }

  .flyer-container::before {
    top: 28px;
    left: 24px;
    right: 4px;
    bottom: 10px;
    border-radius: 16px;
  }

  .flyer-placeholder {
    border-radius: 16px;
    transform: rotate(-1deg);

    box-shadow:
      0 16px 35px rgba(15, 37, 71, 0.2);
  }

  .flyer-tag {
    gap: 5px;
    padding: 7px 11px;

    font-size: 9px;
    letter-spacing: 0.2px;
  }

  .flyer-tag .dot {
    width: 6px;
    height: 6px;
  }

  .flyer-tag.tag-top {
    top: 26px;
    left: 0;
    transform: rotate(-3deg);
  }

  .flyer-tag.tag-bot {
    bottom: 34px;
    right: 0;
    transform: rotate(3deg);
  }
}

/* ========================================
   SMALL MOBILE <= 360px
======================================== */

@media (max-width: 360px) {
  .flyer-container {
    padding: 16px 12px 20px;
  }

  .flyer-tag {
    font-size: 8px;
    padding: 6px 9px;
  }

  .flyer-tag.tag-top {
    top: 22px;
  }

  .flyer-tag.tag-bot {
    bottom: 28px;
  }
}

/* ========================================
   REDUCED MOTION
======================================== */

@media (prefers-reduced-motion: reduce) {
  .flyer-placeholder {
    transition: none;
    transform: none;
  }

  .flyer-placeholder:hover {
    transform: none;
  }
}


/* ============ STATS BAR ============ */
.stats-bar {
  background: var(--navy);
  padding: 32px 0;
  position: relative;
  overflow: hidden;
}
.stats-bar::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 50%, rgba(232, 93, 31, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 50%, rgba(201, 162, 74, 0.1) 0%, transparent 50%);
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
  position: relative;
  text-align: center;
}
.stat-item .big {
  font-family: 'Playfair Display', serif;
  font-size: 42px;
  font-weight: 800;
  color: white;
  line-height: 1;
}
.stat-item .big .accent { color: var(--orange); }
.stat-item .label {
  color: rgba(255,255,255,0.65);
  font-size: 12px;
  letter-spacing: 2px;
  margin-top: 8px;
  text-transform: uppercase;
}

/* ============ SECTIONS ============ */
section { padding: 100px 0; position: relative; }
.section-title {
  font-size: 42px;
  font-weight: 700;
  margin-bottom: 18px;
  max-width: 760px;
}
.section-intro {
  font-size: 17px;
  color: var(--text-muted);
  max-width: 680px;
  margin-bottom: 56px;
}

/* Section divider */
.divider-wave {
  position: absolute;
  top: 0; left: 0; width: 100%;
  overflow: hidden;
  line-height: 0;
  transform: translateY(-99%);
}
.divider-wave svg {
  position: relative;
  display: block;
  width: 100%;
  height: 60px;
}

/* ============ FOR WHOM / PAIN POINTS ============ */
.for-whom {
  background: var(--cream-light);
  position: relative;
}
.audience-tags {
  margin-bottom: 24px;
}
.audience-tag {
  display: inline-block;
  background: white;
  border: 1px solid var(--border);
  color: var(--navy);
  padding: 8px 18px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 600;
  margin: 4px 6px 4px 0;
  transition: all 0.2s;
}
.audience-tag:hover {
  background: var(--navy);
  color: white;
  transform: translateY(-2px);
}
.audience-tag.active {
  background: var(--orange);
  color: white;
  border-color: var(--orange);
}

.pain-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.pain-card {
  background: white;
  padding: 30px 28px;
  border-radius: 16px;
  border: 1px solid var(--border);
  display: flex;
  gap: 20px;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}
.pain-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px; height: 0;
  background: var(--orange);
  transition: height 0.3s;
}
.pain-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px rgba(15, 37, 71, 0.1);
  border-color: transparent;
}
.pain-card:hover::before { height: 100%; }
.pain-card .num {
  flex-shrink: 0;
  width: 48px; height: 48px;
  background: linear-gradient(135deg, var(--orange-light) 0%, #FFE4D1 100%);
  color: var(--orange);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', serif;
  font-weight: 700;
  font-size: 22px;
}
.pain-card h4 {
  font-size: 17px;
  margin-bottom: 6px;
  font-family: 'Inter', sans-serif;
  font-weight: 600;
  color: var(--navy);
}
.pain-card p {
  font-size: 14.5px;
  color: var(--text-muted);
  line-height: 1.6;
}

/* ============ JOURNEY ============ */
.journey {
  background: var(--cream);
  position: relative;
  overflow: hidden;
}
.journey::before {
  content: 'JOURNEY';
  position: absolute;
  top: 30px; right: -40px;
  font-family: 'Playfair Display', serif;
  font-size: 180px;
  font-weight: 800;
  color: rgba(15, 37, 71, 0.025);
  letter-spacing: 10px;
  pointer-events: none;
}
.journey-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  position: relative;
}
.journey-grid::before {
  content: '';
  position: absolute;
  top: 44px; left: 10%;
  width: 80%; height: 2px;
  background: repeating-linear-gradient(90deg, var(--orange) 0 8px, transparent 8px 16px);
  z-index: 0;
}
.journey-card {
  background: white;
  padding: 36px 24px;
  border-radius: 16px;
  text-align: center;
  border: 1px solid var(--border);
  position: relative;
  z-index: 2;
  transition: all 0.3s;
}
.journey-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 50px rgba(15, 37, 71, 0.12);
}
.journey-card .step {
  width: 56px; height: 56px;
  background: var(--navy);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  margin: -56px auto 20px;
  border: 4px solid var(--cream);
  box-shadow: 0 6px 16px rgba(15, 37, 71, 0.2);
}
.journey-card:nth-child(1) .step { background: var(--orange); }
.journey-card:nth-child(2) .step { background: var(--navy); }
.journey-card:nth-child(3) .step { background: var(--gold); }
.journey-card:nth-child(4) .step { background: var(--navy-deep); }
.journey-card h4 {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  color: var(--navy);
  margin: 0 0 10px;
  letter-spacing: -0.3px;
}
.journey-card p {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.6;
}

/* ============ SPEAKER ============ */
.speaker {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 100%);
  color: white;
  position: relative;
  overflow: hidden;
}
.speaker::before {
  content: '"';
  position: absolute;
  top: -40px; left: 10%;
  font-family: 'Playfair Display', serif;
  font-size: 400px;
  color: rgba(232, 93, 31, 0.08);
  font-weight: 800;
  line-height: 1;
}
.speaker .deco-line .text { color: var(--gold); }
.speaker .deco-line::before,
.speaker .deco-line::after { background: var(--gold); }
.speaker .section-title { color: white; }
.speaker .section-intro { color: rgba(255,255,255,0.75); }

.speaker-grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 60px;
  align-items: center;
  position: relative;
}
.speaker-photo-wrap {
  position: relative;
}
.speaker-photo-wrap::before {
  content: '';
  position: absolute;
  top: 20px; left: 20px;
  width: 100%; height: 100%;
  border: 2px solid var(--orange);
  border-radius: 24px;
}
.speaker-photo {
  width: 100%;
  aspect-ratio: 4/5;
  background: linear-gradient(135deg, var(--orange) 0%, var(--orange-dark) 100%);
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  font-family: 'Playfair Display', serif;
  box-shadow: 0 24px 60px rgba(0,0,0,0.4);
  position: relative;
  z-index: 2;
  overflow: hidden;
}
.speaker-photo .initials {
  font-size: 90px;
  font-weight: 700;
  line-height: 1;
}
.speaker-photo .photo-hint {
  position: absolute;
  bottom: 20px;
  font-size: 10px;
  letter-spacing: 2px;
  color: rgba(255,255,255,0.6);
  font-family: 'Inter', sans-serif;
}

.speaker-info h3 {
  font-size: 42px;
  color: white;
  margin-bottom: 6px;
}
.speaker-info .role {
  color: var(--gold);
  font-size: 14px;
  letter-spacing: 2px;
  margin-bottom: 12px;
  font-weight: 600;
  text-transform: uppercase;
}
.speaker-info p {
  font-size: 16px;
  color: rgba(255,255,255,0.85);
  margin-bottom: 16px;
}
.speaker-info p strong { color: var(--gold); font-weight: 600; }

.speaker-quote {
  margin-top: 14px;
  padding: 20px 24px;
  background: rgba(255,255,255,0.04);
  border-left: 3px solid var(--orange);
  border-radius: 8px;
  font-style: italic;
  font-size: 15px;
  color: rgba(255,255,255,0.9);
}


/* ======================================
   PRICING SECTION
====================================== */

.pricing,
.form-section {
  position: relative;
  isolation: isolate;
  box-sizing: border-box;
}

.pricing *,
.pricing *::before,
.pricing *::after,
.form-section *,
.form-section *::before,
.form-section *::after {
  box-sizing: border-box;
}

.pricing {
  background: var(--cream-light, #fffcf8);
  padding: clamp(64px, 8vw, 110px) 20px;
  scroll-margin-top: 80px;
}

.pricing::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background-image: radial-gradient(
    circle at 2px 2px,
    rgba(15, 37, 71, 0.08) 1px,
    transparent 0
  );
  background-size: 32px 32px;
  opacity: 0.5;
  pointer-events: none;
}

.pricing > .container {
  width: 100%;
  max-width: 1120px;
  margin-inline: auto;
}

.pricing .section-title {
  max-width: 800px;
  margin: 0 auto 18px;
  font-size: clamp(30px, 4vw, 46px);
  line-height: 1.2;
  text-align: center;
  text-wrap: balance;
}

.pricing .section-intro {
  max-width: 760px;
  margin: 0 auto clamp(40px, 6vw, 64px);
  text-align: center;
  line-height: 1.75;
}

/* ======================================
   PRICING GRID
====================================== */

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
  align-items: stretch;
  max-width: 1000px;
  margin-inline: auto;
  position: relative;
  z-index: 1;
}

/* ======================================
   PRICE CARD
====================================== */

.price-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  width: 100%;
  padding: 40px 36px;
  border: 2px solid var(--border, #e5e7eb);
  border-radius: 24px;
  background: #fff;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

button,
a.nav-cta,
a.cta-primary {
  border-radius: 20px;
}

@media (hover: hover) {
  .price-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 60px rgba(15, 37, 71, 0.12);
  }
}

/* Premium */

.price-card.premium {
  background: linear-gradient(
    135deg,
    var(--navy, #0f2547) 0%,
    var(--navy-deep, #07152b) 100%
  );
  color: white;
  border: 2px solid transparent;
  transform: scale(1.02);
  box-shadow: 0 24px 60px rgba(15, 37, 71, 0.25);
}

.price-card.premium::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background: radial-gradient(
    circle at top right,
    rgba(232, 93, 31, 0.2) 0%,
    transparent 60%
  );
  border-radius: inherit;
  pointer-events: none;
}

.price-card > :not(.price-badge) {
  position: relative;
  z-index: 1;
}

@media (hover: hover) {
  .price-card.premium:hover {
    transform: scale(1.02) translateY(-6px);
    box-shadow: 0 28px 65px rgba(15, 37, 71, 0.32);
  }
}

/* ======================================
   PRICE BADGE
====================================== */

.price-badge {
  position: absolute;
  top: -15px;
  right: 24px;
  z-index: 3;

  max-width: calc(100% - 36px);
  padding: 8px 16px;

  border-radius: 50px;
  background: var(--orange, #e85d1f);
  color: white;

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.2px;
  line-height: 1.4;
  text-align: center;

  box-shadow: 0 6px 16px rgba(232, 93, 31, 0.3);
}

/* ======================================
   PRICE TYPOGRAPHY
====================================== */

.price-tier {
  font-size: 11px;
  letter-spacing: 2.5px;
  font-weight: 700;
  color: var(--orange, #e85d1f);
  margin-bottom: 12px;
}

.price-card.premium .price-tier {
  color: var(--gold, #c9a24a);
}

.price-card h3 {
  margin: 0 0 24px;
  font-size: clamp(24px, 2.8vw, 28px);
  line-height: 1.3;
  color: var(--navy, #0f2547);
  overflow-wrap: anywhere;
}

.price-card.premium h3 {
  color: white;
}

/* Price amount */

.price-amount {
  display: flex;
  align-items: flex-start;
  gap: 4px;
  max-width: 100%;

  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(38px, 4.5vw, 52px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1.5px;
  white-space: nowrap;

  color: var(--navy, #0f2547);
  margin-bottom: 10px;
}

.price-amount .currency {
  flex-shrink: 0;
  margin-top: 4px;
  font-family: "Inter", sans-serif;
  font-size: 19px;
  font-weight: 600;
  letter-spacing: 0;
  color: var(--text-muted, #64748b);
}

.price-card.premium .price-amount {
  color: white;
}

.price-card.premium .price-amount .currency {
  color: rgba(255, 255, 255, 0.7);
}

.price-note {
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-muted, #64748b);

  margin: 0 0 22px;
  padding-bottom: 24px;

  border-bottom: 1px dashed var(--border, #e5e7eb);
}

.price-card.premium .price-note {
  color: rgba(255, 255, 255, 0.7);
  border-bottom-color: rgba(255, 255, 255, 0.15);
}

/* ======================================
   PRICE FEATURES
====================================== */

.price-features {
  list-style: none;
  margin: 0 0 24px;
  padding: 0;
  width: 100%;
  flex: 1;
}

.price-features li {
  position: relative;
  padding: 12px 0 12px 33px;
  min-width: 0;

  font-size: 14px;
  line-height: 1.65;
  overflow-wrap: break-word;
  color: var(--text, #334155);

  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.price-features li:last-child {
  border-bottom: none;
}

.price-features li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14px;

  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--orange-light, #fff0e7);
}

.price-features li::after {
  content: "✓";
  position: absolute;
  left: 5px;
  top: 14px;

  font-family: sans-serif;
  font-size: 12px;
  font-weight: 700;
  color: var(--orange, #e85d1f);
}

.price-card.premium .price-features li {
  color: rgba(255, 255, 255, 0.92);
  border-bottom-color: rgba(255, 255, 255, 0.08);
}

.price-card.premium .price-features li::before {
  background: rgba(201, 162, 74, 0.2);
}

.price-card.premium .price-features li::after {
  color: var(--gold, #c9a24a);
}

/* ======================================
   ADD ON
====================================== */

.add-on {
  margin-top: auto;
  padding: 18px 20px;

  background: var(--orange-light, #fff0e7);
  border: 1px dashed var(--orange, #e85d1f);
  border-radius: 12px;

  font-size: 13.5px;
  line-height: 1.65;
  color: var(--navy, #0f2547);
}

.add-on strong {
  display: block;
  margin-bottom: 5px;
  color: var(--orange, #e85d1f);
  font-size: 12px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.price-card.premium .add-on {
  background: rgba(201, 162, 74, 0.12);
  border-color: var(--gold, #c9a24a);
  color: var(--gold-light, #f1dcac);
}

.price-card.premium .add-on strong {
  color: var(--gold, #c9a24a);
}

/* ======================================
   FORM SECTION
====================================== */

.form-section {
  background: var(--cream, #faf7f2);
  padding: clamp(64px, 8vw, 110px) 20px;
  overflow: hidden;
}

.form-section::before,
.form-section::after {
  content: "";
  position: absolute;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  pointer-events: none;
}

.form-section::before {
  top: 100px;
  left: -200px;
  background: radial-gradient(
    circle,
    rgba(232, 93, 31, 0.08) 0%,
    transparent 70%
  );
}

.form-section::after {
  right: -200px;
  bottom: 100px;
  background: radial-gradient(
    circle,
    rgba(15, 37, 71, 0.06) 0%,
    transparent 70%
  );
}

.form-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 680px;
  margin-inline: auto;
  text-align: center;
}

.form-wrap .section-title,
.form-wrap .section-intro {
  margin-left: auto;
  margin-right: auto;
}

.form-card {
  width: 100%;
  margin-top: 11px;
  padding: 48px 40px;

  background: white;
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 24px;

  text-align: left;
  box-shadow: 0 24px 60px rgba(15, 37, 71, 0.08);
}

.form-card-header {
  text-align: center;
  padding-bottom: 24px;
  margin-bottom: 14px;
  border-bottom: 1px solid var(--border, #e5e7eb);
}

.form-card-header .step-indicator {
  display: inline-flex;
  gap: 6px;
  margin-bottom: 10px;
}

.form-card-header .step-indicator span {
  width: 24px;
  height: 4px;
  background: var(--orange, #e85d1f);
  border-radius: 2px;
}

.form-card-header h4 {
  margin: 0;
  font-size: 20px;
  line-height: 1.4;
  font-family: "Inter", sans-serif;
  font-weight: 700;
  color: var(--navy, #0f2547);
}

/* Form Fields */

.form-field {
  margin-bottom: 11px;
  min-width: 0;
}

.form-field label {
  display: block;
  margin-bottom: 8px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: var(--navy, #0f2547);
}

.form-field label .req {
  color: var(--orange, #e85d1f);
}

.form-field input,
.form-field select,
.form-field textarea {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 50px;
  padding: 14px 16px;

  border: 1.5px solid var(--border, #e5e7eb);
  border-radius: 12px;
  background: var(--cream-light, #fffcf8);

  color: var(--navy, #0f2547);
  font-family: inherit;
  font-size: 16px;
  line-height: 1.5;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  outline: none;
  border-color: var(--orange, #e85d1f);
  background: white;
  box-shadow: 0 0 0 4px rgba(232, 93, 31, 0.1);
}

/* Submit Button */

.form-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  width: 100%;
  min-height: 56px;
  margin-top: 8px;
  padding: 16px 20px;

  background: var(--orange, #e85d1f);
  border: none;
  border-radius: 50px;
  color: white;

  font-family: inherit;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;

  cursor: pointer;
  transition:
    background 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;

  box-shadow: 0 10px 28px rgba(232, 93, 31, 0.3);
}

@media (hover: hover) {
  .form-submit:hover {
    background: var(--orange-dark, #ca4816);
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(232, 93, 31, 0.4);
  }
}

.form-submit:focus-visible {
  outline: 3px solid var(--navy, #0f2547);
  outline-offset: 3px;
}

.form-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  box-shadow: none;
  transform: none;
}

.form-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  margin-top: 12px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--text-muted, #64748b);
  text-align: center;
}

.form-note::before {
  content: "🔒";
  font-size: 14px;
}

/* ======================================
   RESPONSIVE: TABLET <= 900px
====================================== */

@media (max-width: 900px) {
  .pricing-grid {
    grid-template-columns: minmax(0, 1fr);
    max-width: 560px;
    gap: 36px;
  }

  .price-card {
    padding: 36px 32px;
  }

  .price-card.premium {
    transform: none;
  }

  @media (hover: hover) {
    .price-card.premium:hover {
      transform: translateY(-6px);
    }
  }

  .price-amount {
    font-size: 50px;
  }
}

/* ======================================
   RESPONSIVE: MOBILE <= 600px
====================================== */

@media (max-width: 600px) {
  .pricing,
  .form-section {
    padding: 64px 16px;
  }

  .pricing .section-title {
    font-size: clamp(28px, 7vw, 36px);
    line-height: 1.25;
  }

  .pricing .section-intro {
    font-size: 14px;
    line-height: 1.75;
    margin-bottom: 22px;
  }

  .pricing-grid {
    gap: 34px;
  }

  .price-card {
    padding: 32px 24px;
    border-radius: 20px;
  }

  .price-card h3 {
    font-size: 25px;
    margin-bottom: 11px;
  }

  .price-tier {
    font-size: 10px;
    letter-spacing: 2px;
  }

  .price-amount {
    font-size: clamp(38px, 9vw, 46px);
    letter-spacing: -1px;
  }

  .price-amount .currency {
    font-size: 17px;
  }

  .price-note {
    font-size: 12.5px;
    margin-bottom: 8px;
    padding-bottom: 20px;
  }

  .price-features li {
    font-size: 13.5px;
    padding: 11px 0 11px 31px;
  }

  .price-badge {
    top: -14px;
    right: 18px;
    padding: 7px 12px;
    font-size: 9.5px;
    letter-spacing: 0.8px;
  }

  .add-on {
    padding: 16px;
    font-size: 13px;
  }

  /* Form */
  .form-card {
    padding: 32px 24px;
    border-radius: 20px;
  }

  .form-card-header {
    padding-bottom: 10px;
    margin-bottom: 8px;
  }

  .form-card-header h4 {
    font-size: 18px;
  }

  .form-field {
    margin-bottom: 8px;
  }

  .form-submit {
    min-height: 54px;
    font-size: 15px;
  }
}

/* ======================================
   RESPONSIVE: SMALL MOBILE <= 380px
====================================== */

@media (max-width: 380px) {
  .pricing,
  .form-section {
    padding-left: 12px;
    padding-right: 12px;
  }

  .price-card {
    padding: 28px 20px;
  }

  .price-card h3 {
    font-size: 23px;
  }

  .price-amount {
    font-size: 36px;
  }

  .price-amount .currency {
    font-size: 15px;
  }

  .price-badge {
    right: 12px;
    font-size: 9px;
    letter-spacing: 0.4px;
  }

  .form-card {
    padding: 28px 18px;
  }
}



/* ============ FAQ ============ */
.faq { background: var(--cream-light); }
.faq-list {
  max-width: 820px;
  margin: 0 auto;
}
.faq-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  margin-bottom: 7px;
  overflow: hidden;
  transition: all 0.2s;
}
.faq-item:hover { border-color: var(--orange); }
.faq-item[open] {
  border-color: var(--orange);
  box-shadow: 0 8px 24px rgba(232, 93, 31, 0.08);
}
.faq-q {
  padding: 22px 26px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
  color: var(--navy);
  font-size: 15.5px;
  user-select: none;
  list-style: none;
  gap: 20px;
}
.faq-q::-webkit-details-marker { display: none; }
.faq-q::after {
  content: '+';
  font-size: 28px;
  color: var(--orange);
  font-weight: 300;
  transition: transform 0.3s;
  flex-shrink: 0;
  line-height: 1;
}
details[open] .faq-q::after {
  content: '−';
  transform: rotate(180deg);
}
.faq-a {
  padding: 0 26px 24px;
  color: var(--text-muted);
  font-size: 14.5px;
  line-height: 1.7;
}



/* ============ RESPONSIVE ============ */
@media (max-width: 900px) {
  .hero { padding: 40px 0 70px; }
  .hero-grid { grid-template-columns: 1fr; gap: 50px; }
  .hero h1 { font-size: 36px; }
  .hero-sub1 { font-size: 16px; }
  .section-title { font-size: 30px; }
  .pain-grid { grid-template-columns: 1fr; }
  .journey-grid { grid-template-columns: repeat(2, 1fr); }
  .journey-grid::before { display: none; }
  .journey-card .step { margin-top: 0; }
  .speaker-grid { grid-template-columns: 1fr; text-align: center; }
  .speaker-photo-wrap { max-width: 240px; margin: 0 auto; }
  .speaker-info h3 { font-size: 32px; }
  .pricing-grid { grid-template-columns: 1fr; }
  .price-card.premium { transform: none; }
  .price-card.premium:hover { transform: translateY(-6px); }
  .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .stat-item .big { font-size: 32px; }
  section { padding: 70px 0; }
  .form-card { padding: 32px 24px; }
  .flyer-tag.tag-top { left: 10px; }
  .flyer-tag.tag-bot { right: 10px; }
}
@media (max-width: 500px) {
  .journey-grid { grid-template-columns: 1fr; }
  .hero h1 { font-size: 30px; }
