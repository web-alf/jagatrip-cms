---
interface Props { crumbs: [string, string?][]; eyebrow: string; title: string; lead?: string; image?: string; imageAlt?: string; imageBadge?: string }
const { crumbs, eyebrow, title, lead, image, imageAlt, imageBadge } = Astro.props;
---
<section style="position:relative;overflow:hidden;border-bottom:1px solid var(--border)">
  <svg aria-hidden="true" class="deco" viewBox="0 0 1440 400" preserveAspectRatio="none">
    <path d="M-40 340 C 340 306 620 136 1000 92 C 1170 72 1320 54 1500 36" fill="none" stroke="#F97316" stroke-width="2" stroke-dasharray="2 10" opacity=".45" />
    <g transform="translate(1455 22) rotate(-6) scale(.8)" opacity=".45"><path d="M3 13l18-7-7 18-2.6-7.4L3 13z" fill="#F97316" /></g>
  </svg>
  <div class="wrap" style={image ? "padding-block:clamp(40px,5vw,72px);display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(24px,4vw,56px);align-items:center" : "padding-block:clamp(40px,5vw,72px)"}>
    <div>
      <nav aria-label="Breadcrumb" class="crumb">
        <ol>{crumbs.map(([l, href]) => <li>{href ? <a href={href}>{l}</a> : <span aria-current="page">{l}</span>}</li>)}</ol>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h1">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image && (
      <div style="position:relative;border:1px solid var(--border);background:var(--bg);padding:12px">
        <img src={image} alt={imageAlt || ""} loading="eager" decoding="async" style="display:block;width:100%;height:auto" />
        {imageBadge && <div class="badge" style="position:absolute;left:24px;bottom:24px;background:var(--navy);color:#fff;padding:12px 16px">{imageBadge}</div>}
      </div>
    )}
  </div>
</section>
<style>
  @media (max-width: 760px) {
    .wrap[style*="grid-template-columns"] { display: flex !important; flex-direction: column-reverse; }
  }
</style>
