---
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";

interface Props { title: string; description?: string; preload?: string }
const { title, description = "JAGATRIP menghubungkan sekolah, praktisi pendidikan, pelajar, dan institusi dengan program Edu-Tourism, international benchmarking, serta institutional partnership.", preload } = Astro.props;
const FONT = "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap";
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="qIk7qwGT5DyIB4Eiqo-_v78Ttl2SRAwYzg2op-_tUCA" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/webp" href="/assets/brand/logogram.webp" />
  {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={FONT} onload="this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href={FONT} /></noscript>
</head>
<body>
  <Header />
  <main id="top"><slot /></main>
  <Footer />
  <script>
    // Reveal-on-scroll + generic carousel ([data-carousel] > .slides, [data-prev]/[data-next]/[data-go]).
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
      const track = root.querySelector<HTMLElement>(".slides")!;
      const n = track.children.length;
      let i = 0, timer = 0;
      const go = (k: number) => {
        i = (k + n) % n;
        track.style.transform = `translateX(-${i * 100}%)`;
        root.querySelectorAll("[data-go]").forEach((b, j) => b.setAttribute("aria-current", String(j === i)));
        root.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => (el.hidden = +el.dataset.i! !== i));
        root.querySelectorAll("[data-count]").forEach((el) => (el.textContent = `${i + 1} / ${n}`));
        clearInterval(timer);
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) timer = window.setInterval(() => go(i + 1), 2000);
      };
      root.addEventListener("click", (e) => {
        const b = (e.target as Element).closest<HTMLElement>("[data-prev],[data-next],[data-go]");
        if (b) go(b.dataset.go != null ? +b.dataset.go : i + (b.hasAttribute("data-next") ? 1 : -1));
      });
      go(0);
    });
  </script>
</body>
</html>
